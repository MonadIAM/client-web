{
  "extends": "./configs/tsconfig.base.json", // Root config, better to avoid editing!
  "compilerOptions": {
    "paths": {
      "~ui/*": ["./node_modules/@monadiam/ui-kit/src/*"],
      "~src/*": ["./src/*"],
      "~common/*": ["./src/common/*"],
      "~api": ["./src/common/api"],
      "~api/*": ["./src/common/api/*"],
      "~auth": ["./src/common/auth"],
      "~auth/*": ["./src/common/auth/*"],
      "~layout": ["./src/layout"],
      "~layout/*": ["./src/layout/*"],
      "~pages/*": ["./src/pages/*"],
      "~router": ["./src/router"],
      "~router/*": ["./src/router/*"],
      "~assets/*": ["./src/assets/*"],
      "~root/*": ["./*"]
    },
    "types": ["react", "react-dom", "node"], // React types and Node.js types used by environment validation.
    "rootDir": ".",                          // Includes application source and the root environment schema.
  },
  "include": [
    "env.schema.ts",
    "env.d.ts",
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "configs",
    "dist",
  ]
}
